# Peach environment — copy to .env.local and fill in.
# NEVER commit the real .env.local.

# Neon (PostgreSQL) — your serverless database connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Google OAuth
# Create a client at https://console.cloud.google.com/apis/credentials
# (Application type: Web application). Add these redirect URIs:
#   - Authorized JavaScript origin: https://<your-app>.vercel.app
#   - Authorized redirect URI:      https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js — any long random string. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set to your deployed URL before going live
AUTH_URL=
