// Peach data model — Neon (PostgreSQL) via Prisma ORM.
//
// Auth is email + password (hashed with bcrypt), stored on the User row. All
// money is stored as integer cents (amount, share amount, wallet balance) to
// avoid float drift; the API converts to dollars before handing data to the
// client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?  // nullable for OAuth users (Google sign-in)
  image        String?
  emailVerified DateTime?

  // Peach domain
  balance      Int            @default(0) // wallet, in cents
  dailyLimitCents Int?        // daily spending limit, in cents (null = no limit)
  categoryLimits String?      // JSON string: { "FOOD": 5000, "TRANSPORT": 3000 } (cents, null = no limits)
  roomId       String?
  room         Room?          @relation("Membership", fields: [roomId], references: [id])
  ownedRooms   Room[]         @relation("Owned")
  expensesPaid Expense[]      @relation("PaidBy")
  expensesCreated Expense[]   @relation("CreatedBy")
  shares       ExpenseShare[]
  pushSubscriptions PushSubscription[]

  // Password reset (hashed token + expiry)
  resetToken       String?
  resetTokenExpiry DateTime?

  @@index([roomId])
}

// --- Peach domain -----------------------------------------------------------

model Room {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique // PEACH-XXX
  ownerId   String
  createdAt DateTime  @default(now())

  owner    User      @relation("Owned", fields: [ownerId], references: [id])
  members  User[]    @relation("Membership")
  expenses Expense[]
}

model Expense {
  id          String           @id @default(cuid())
  roomId      String?          // null = personal expense, owned only by the creator
  title       String
  description String?          // optional long-form details, shown in the expense detail modal
  category    ExpenseCategory  @default(OTHERS)
  amount      Int              // total, in cents
  paidBy      String
  createdBy   String           // who added this entry (only they may delete it)
  createdAt   DateTime         @default(now())

  room   Room?          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  payer  User           @relation("PaidBy", fields: [paidBy], references: [id])
  creator User          @relation("CreatedBy", fields: [createdBy], references: [id])
  shares ExpenseShare[]
}

// One row per member per expense — the split status lives here.
model ExpenseShare {
  id        String       @id @default(cuid())
  expenseId String
  userId    String
  amount    Int          // this member's share, in cents
  status    ShareStatus  @default(PENDING)
  paidAt    DateTime?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

enum ShareStatus {
  PENDING
  PENDING_VERIFICATION // member said they paid — awaiting the payer's approval
  PAID
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  UTILITIES
  ENTERTAINMENT
  MEDICAL
  RENT
  OTHERS
}

// Web Push subscriptions — one row per device/browser per user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
  @@index([userId])
}
